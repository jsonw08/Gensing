<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  Test melody that exercises every note-ID edge case from the contracts:
  - pickup bar (printed as bar 0, but it's m1 in file order)
  - repeated same pitch (m2: G4 G4)
  - big leap (m3: G4 -> D5, +7 semitones)
  - rest in the middle of a phrase (m3-n2) and at the end (m6-n1)
  - tie across a barline (m4-n2 -> m5-n0: one sung note, two noteheads)
  - F#4 accidental from the key signature (G major)
-->
<score-partwise version="4.0">
  <work><work-title>Edge Cases (test)</work-title></work>
  <part-list>
    <score-part id="P1"><part-name>Voice</part-name></score-part>
  </part-list>
  <part id="P1">
    <!-- Pickup bar: 1 beat. MusicXML number "0"; our ID is m1. -->
    <measure number="0" implicit="yes">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>1</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <direction placement="above">
        <direction-type><metronome><beat-unit>quarter</beat-unit><per-minute>80</per-minute></metronome></direction-type>
        <sound tempo="80"/>
      </direction>
      <note><pitch><step>D</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type><lyric><syllabic>single</syllabic><text>Oh</text></lyric></note>
    </measure>
    <measure number="1">
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type><lyric><syllabic>single</syllabic><text>sing</text></lyric></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type><lyric><syllabic>single</syllabic><text>it</text></lyric></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type><lyric><syllabic>single</syllabic><text>out</text></lyric></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type><lyric><syllabic>single</syllabic><text>and</text></lyric></note>
    </measure>
    <measure number="2">
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type><lyric><syllabic>single</syllabic><text>leap</text></lyric></note>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>1</duration><type>quarter</type><lyric><syllabic>single</syllabic><text>high</text></lyric></note>
      <note><rest/><duration>1</duration><type>quarter</type></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>1</duration><type>quarter</type><lyric><syllabic>single</syllabic><text>then</text></lyric></note>
    </measure>
    <measure number="3">
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>2</duration><type>half</type><lyric><syllabic>single</syllabic><text>hold</text></lyric></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type><lyric><syllabic>single</syllabic><text>it</text></lyric></note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch><duration>1</duration>
        <tie type="start"/><type>quarter</type>
        <notations><tied type="start"/></notations>
        <lyric><syllabic>single</syllabic><text>long</text></lyric>
      </note>
    </measure>
    <measure number="4">
      <note>
        <pitch><step>B</step><octave>4</octave></pitch><duration>1</duration>
        <tie type="stop"/><type>quarter</type>
        <notations><tied type="stop"/></notations>
      </note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type><lyric><syllabic>single</syllabic><text>and</text></lyric></note>
      <note><pitch><step>F</step><alter>1</alter><octave>4</octave></pitch><duration>1</duration><type>quarter</type><lyric><syllabic>single</syllabic><text>come</text></lyric></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type><lyric><syllabic>single</syllabic><text>back</text></lyric></note>
    </measure>
    <measure number="5">
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><type>half</type><lyric><syllabic>single</syllabic><text>home</text></lyric></note>
      <note><rest/><duration>2</duration><type>half</type></note>
      <barline location="right"><bar-style>light-heavy</bar-style></barline>
    </measure>
  </part>
</score-partwise>
